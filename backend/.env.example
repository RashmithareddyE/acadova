# Server port
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWTs. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_secret

# How long a login stays valid, in days (default 7)
JWT_EXPIRES_IN_DAYS=7

# Allowed web client origin(s) for CORS; separate several with commas
CLIENT_URL=http://localhost:5173

# Optional local document extraction command. Searchable PDFs use Poppler's pdftotext.
# Local image OCR and English trained data are bundled with backend dependencies.
# PDFTOTEXT_PATH=pdftotext

# Optional vision fallback for timetable images that local OCR cannot parse.
# The image is sent to OpenAI only when local timetable extraction is poor.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4.1-mini
